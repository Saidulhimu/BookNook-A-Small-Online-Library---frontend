NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5001

# BetterAuth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# MongoDB (BetterAuth adapter) - same database as the backend
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/booknook?retryWrites=true&w=majority
DB_NAME=booknook

# JWT: must be identical to JWT_SECRET in the backend .env
JWT_SECRET=

# Google OAuth: fill both and set NEXT_PUBLIC_HAS_GOOGLE_AUTH=true to enable
NEXT_PUBLIC_HAS_GOOGLE_AUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ImgBB (book cover upload)
NEXT_PUBLIC_IMGBB_API_KEY=
