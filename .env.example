# Better Auth Settings
BETTER_AUTH_SECRET=booknook_better_auth_secret_key_32_chars_long_example
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend Server API URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# MongoDB Database URI (Used by BetterAuth MongoDB Adapter)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/booknook?retryWrites=true&w=majority
DB_NAME=booknook

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ImgBB API Key (For Book Cover Uploads)
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key

